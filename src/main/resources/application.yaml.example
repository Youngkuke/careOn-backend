server:
  servlet:
    encoding:
      charset: UTF-8
      enabled: true
      force: true

spring:
  application:
    name: careon
  datasource:
    url: jdbc:postgresql://localhost:5432/careondb
    username: careon
    password: your-db-password
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
    open-in-view: false
  mail:
    host: smtp.gmail.com
    port: 587
    username: your-gmail-address@gmail.com
    password: your-gmail-app-password
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

jwt:
  # openssl rand -base64 64 같은 걸로 새로 생성해서 넣으세요. 실제 값은 커밋하지 마세요.
  secret: your-base64-encoded-secret-key
  web-access-token-validity-seconds: 21600
  app-access-token-validity-seconds: 3600
  refresh-token-validity-seconds: 7776000

wear:
  # 워치 access/refresh token 유효 시간 (jwt.secret과 동일한 키로 서명함)
  access-token-validity-seconds: 3600
  refresh-token-validity-seconds: 15552000

app:
  # 프론트엔드 비밀번호 재설정 페이지 주소. 메일 본문에는 여기에 "?token=<토큰>"을 붙여 보낸다.
  # 운영은 아래 주소를 쓴다. 로컬에서 프론트를 띄워 테스트할 때만 http://localhost:3000/reset-password 로 바꾼다.
  password-reset-url: https://www.careon.site/reset-password

policy:
  # 대안 복지(자가진단 결과와 무관하게 항상 보여주는 제도) 목록. 적은 순서가 화면 순서가 됩니다.
  # 69=긴급복지지원, 70=지역사회 통합돌봄, 71=정신건강 심리상담 바우처사업, 75=재난적 의료비 지원사업
  # 코드에 같은 기본값이 있어서 이 항목을 생략해도 동작합니다.
  alternative-policy-ids: 69,70,71,75

cb:
  # cb.cb_institutions(AI 서버 소유)의 신청 마감일 / 결과 발표일 컬럼명.
  # 비워두면(기본값) 그 칸을 조회하지 않고, 해당 종류의 알림이 cb 제도에는 나가지 않습니다.
  # 컬럼이 아직 없는데 이름을 적으면 찜 목록 조회까지 실패하므로, 상대 팀이 컬럼을 만든 뒤에 채우세요.
  # 값 형식은 date / timestamp / "2026-08-14" / "20260814" / "2026.8.14." 모두 읽습니다.
  deadline-column: "apply_deadline"
  result-date-column: "result_announcement_date"

notification:
  # 마감 알림 배치가 도는 시각. 아래 두 항목은 코드에 같은 기본값이 있어서 생략해도 동작합니다.
  # 기본값(생략 시): "0 0 9 * * *"  — 매일 오전 9시 KST
  # 시연처럼 특정 시각에 보여줘야 할 때만 바꾸고, 끝나면 이 블록을 지워 원래대로 되돌립니다.
  #   예) 오후 2·3·4시            : "0 0 14,15,16 * * *"
  #   예) 오후 4시부터 30분 간격   : "0 0,30 16-19 * * *"
  deadline-cron: "0 0 9 * * *"
  # 이미 만들어둔 알림도 배치가 돌 때마다 푸시를 다시 보낼지. 기본값 false.
  # 같은 마감 알림이 하루에 여러 번 울리면 사용자에겐 스팸이라, 평상시엔 반드시 false로 둡니다.
  # true로 켜도 앱 내 알림 목록은 1건만 유지되고 푸시만 다시 나갑니다. (시연용)
  repeat-push: false

expo:
  push:
    url: https://exp.host/--/api/v2/push/send
    # Expo 대시보드에서 "Enhanced Security for Push Notifications"를 켠 프로젝트만 필요합니다.
    # 안 켰으면 비워두세요. (기본값도 빈 값이라 이 블록 자체를 생략해도 동작합니다)
    access-token: ""
